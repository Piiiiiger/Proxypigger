[Unit]
Description=AI abuse patrol for this explicitly selected node
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ai-abuse-patrol
Group=ai-abuse-patrol
WorkingDirectory=/var/lib/ai-abuse-patrol
EnvironmentFile=-/etc/ai-abuse-patrol/provider.env
ExecStart=/usr/bin/python3 /opt/ai-abuse-patrol/ai-abuse-patrol/scripts/patrol.py --config /etc/ai-abuse-patrol/config.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-abuse-patrol
TimeoutStartSec=31min
KillMode=control-group
